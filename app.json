{
  "expo": {
    "name": "ResellTracker - Guadagni Vinted & eBay",
    "slug": "resell-tracker",
    "version": "1.2.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reselltracker.app"
    },
    "android": {
      "package": "com.reselltracker.app",
      "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID",
        "com.android.vending.BILLING"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app accede alle foto per allegare le immagini ai capi nel tuo inventario.",
          "cameraPermission": "L'app accede alla fotocamera per scattare foto agli articoli da vendere."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "a2a960ad-01b2-49ef-a161-482a99e6b977"
      }
    }
  }
}
